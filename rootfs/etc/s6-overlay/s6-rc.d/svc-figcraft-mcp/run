#!/usr/bin/with-contenv bash
set -eu
if [[ -z "${MCP_API_KEY:-}" ]]; then
  echo '[mcp] MCP_API_KEY missing; refusing to serve' >&2
  sleep 60
  exit 1
fi
export SUPERGATEWAY_API_KEY="$MCP_API_KEY"
cd /storage
bin=$(node -p 'const b=require("/opt/supergateway/package.json").bin; typeof b === "string" ? b : b.supergateway')
exec s6-setuidgid abc node "/opt/supergateway/$bin" --stdio 'node /opt/figcraft-files/bridge.js' --outputTransport streamableHttp --stateful --host 127.0.0.1 --port 8101 --healthEndpoint /healthz
